Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://basemap.nationalmap.gov https://elevation.nationalmap.gov https://sdmdataaccess.sc.egov.usda.gov; connect-src 'self' https://gis.arkansas.gov https://sdmdataaccess.sc.egov.usda.gov https://basemap.nationalmap.gov https://elevation.nationalmap.gov; worker-src blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
